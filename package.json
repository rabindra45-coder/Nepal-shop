{
  "dependencies": {
    "@hatch/space-sdk": "file:./vendor/space-sdk.tgz",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-query": "5.100.10",
    "drizzle-orm": "0.45.2",
    "nodemailer": "^10.0.10",
    "postgres": "^3.4.9",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.1.13",
    "tailwindcss-safe-area": "1.3.0",
    "typescript": "5.6.3"
  },
  "name": "nepal-shopping-site",
  "packageManager": "bun@1.3.10",
  "private": true,
  "scripts": {
    "build": "bun run build:server && bun run build:client",
    "build:client": "bun ./client/build.mjs",
    "build:server": "cd server && bun build ./src/actions.ts --target=bun --outfile=./dist/actions.js",
    "start": "bun selfhost.ts",
    "typecheck": "bun x tsc --noEmit -p client/tsconfig.json && bun x tsc --noEmit -p server/tsconfig.json"
  },
  "type": "module"
}