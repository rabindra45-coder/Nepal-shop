# Nepal Shop — environment configuration.
# Copy this file to `.env` and fill in the real values. Never commit a filled-in
# `.env` file. Every value here is a placeholder or empty on purpose.

# --- Server ---
PORT=3000

# --- Supabase Postgres (the database) ---
# The server needs a Postgres connection string. Use the Supabase connection
# pooler (port 6543) — it survives traffic spikes and sleep/wake cycles.
# Find it in the Supabase dashboard: Project Settings → Database → Connection
# string → URI (use the "pooler" host, usually aws-0-<region>.pooler.supabase.com).
# Replace <DB_PASSWORD> with the database password from Project Settings → Database.
DATABASE_URL=postgres://postgres.bdocgqightjjthuosvch:<DB_PASSWORD>@<pooler-host>:6543/postgres

# --- Supabase Storage (product/banner/avatar/store images) ---
# SUPABASE_URL: the project URL — Project Settings → General → Project URL.
SUPABASE_URL=https://bdocgqightjjthuosvch.supabase.co
# Service-role key: Project Settings → API → service_role (secret). Server-side
# ONLY — it bypasses storage policies. Never commit it, never expose it to the
# client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# Set to 1 on production boots so the demo seed (admin, demo sellers,
# sample products) is NOT inserted into the live database:
# SKIP_SEED=1

# No persistent disk is needed anymore: the database lives in Supabase
# Postgres and uploads live in Supabase Storage buckets, so deploys and
# sleep/wake cycles lose nothing. DB_PATH and UPLOADS_DIR are legacy
# local-disk settings; UPLOADS_DIR is still honoured as a best-effort
# fallback for pre-migration /uploads/* rows only.

# --- Public base URL (used for payment callbacks, sitemap and robots.txt) ---
PUBLIC_BASE_URL=http://localhost:3000

# --- First production admin (safe way to go live) ---
# Set these BEFORE the first production boot. The server creates the real admin
# account with a bcrypt-hashed password if no admin with this email exists yet.
# Leave them empty to keep using the dev seed admin for local testing.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- eSewa online payments ---
# Get a merchant account at https://merchant.esewa.com.np/ — eSewa issues your
# merchant code (product_code) and secret key during onboarding.
# For testing, eSewa publishes sandbox credentials (merchant code EPAYTEST)
# in their developer docs at https://developer.esewa.com.np/
ESEWA_MERCHANT_ID=
ESEWA_SECRET_KEY=
ESEWA_MODE=test            # test | live

# --- Khalti online payments ---
# Register as a merchant at https://khalti.com/ — your secret key is issued in
# the Khalti merchant dashboard.
KHALTI_SECRET_KEY=
KHALTI_MODE=test           # test | live

# --- AI product recommendations ---
# Powers the "Recommended for you" picks on product pages. Optional — without
# it the shop uses honest rule-based picks. Get a free key at
# https://aistudio.google.com/
GEMINI_API_KEY=

# --- Transactional email (fully wired: orders, payments, shipments, accounts) ---
# All values are read server-side only. For Gmail, use an app password
# (Google Account → Security → 2-Step Verification → App passwords) as
# SMTP_PASS — never your real Google password. See README "Production email
# setup". When these are absent, emails return { sent: false } and the server
# logs "[email] not configured" — checkout and all other flows keep working.
SMTP_HOST=
SMTP_PORT=587              # 465 = implicit TLS, 587 = STARTTLS
SMTP_USER=
SMTP_PASS=
SMTP_FROM=                 # the From: address buyers and sellers see
ADMIN_EMAIL=               # also receives admin alerts (new sellers, payouts,
                           # payment failures). Set above for the first admin.
# EMAIL_TEST_CAPTURE=1     # test-only: capture emails in memory instead of
                           # sending. Never set in production.
